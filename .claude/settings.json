            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "python3 /Users/aryanmotgi/.grillme/bin/grillme-hook post Aryan /Users/aryanmotgi/.grillme",
            "type": "command"
          }
        ],
        "matcher": "Bash|Read|Edit|Write"
      }
    ],
    "PreToolUse": [
